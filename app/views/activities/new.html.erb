<div class="activity-edit-header">
  <div class="activity-edit-header__thumb activity-edit-header__thumb--dashed">
    <i class="fa-solid fa-plus"></i>
  </div>

  <div class="activity-edit-header__info">
    <h3 class="activity-edit-header__name">add activity</h3>
    <p class="activity-edit-header__subtitle">Day <%= @day_number %> · <%= @trip_day.date.strftime("%A, %b %-d") %></p>
  </div>
</div>

<%= simple_form_for [@trip, @trip_day, @activity] do |f| %>
  <%= f.error_notification %>

  <div class="mb-3">
    <label class="form-label" for="activity_name">title</label>
    <%= f.text_field :name, id: "activity_name", class: "form-control",
          placeholder: "what are you doing?", required: true %>
  </div>

  <div class="mb-3"
       data-controller="address-search"
       data-address-search-access-token-value="<%= ENV["MAPBOX_ACCESS_TOKEN"] %>"
       data-action="click@window->address-search#closeOnOutsideClick">
    <label class="form-label" for="activity_address">location</label>
    <%= f.text_field :address, id: "activity_address", class: "form-control",
          placeholder: "search for an address", autocomplete: "off",
          data: { address_search_target: "input", action: "input->address-search#search" } %>
    <div class="address-search__results" data-address-search-target="results" hidden></div>
    <%= f.hidden_field :latitude, data: { address_search_target: "latitude" } %>
    <%= f.hidden_field :longitude, data: { address_search_target: "longitude" } %>
  </div>

  <div class="time-fields">
    <div class="time-field">
      <label class="form-label" for="activity_start_time">start</label>
      <div class="time-field__box">
        <i class="fa-regular fa-clock time-field__icon"></i>
        <%= time_field_tag "activity[start_time]", nil,
              id: "activity_start_time", class: "time-field__input", required: true %>
      </div>
    </div>

    <div class="time-field">
      <label class="form-label" for="activity_end_time">end</label>
      <div class="time-field__box">
        <i class="fa-regular fa-clock time-field__icon"></i>
        <%= time_field_tag "activity[end_time]", nil,
              id: "activity_end_time", class: "time-field__input", required: true %>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <span class="form-label">category</span>
    <div class="category-select">
      <% Activity::CATEGORIES.each do |cat| %>
        <label class="category-chip">
          <%= f.radio_button :category, cat, class: "category-chip__input" %>
          <span class="category-chip__label"><%= cat %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="mb-3">
    <div class="notes-field__header">
      <label class="form-label" for="activity_notes">notes</label>
      <span class="notes-field__optional">optional</span>
    </div>
    <%= f.text_area :notes, id: "activity_notes", class: "form-control notes-field__textarea",
          rows: 4, placeholder: "anything to remember?" %>
  </div>

  <div class="form-actions">
    <%= link_to "cancel", trip_path(@trip, day: @day_number), class: "btn-itinera-secondary" %>
    <%= f.button :submit, "add activity", class: "btn-itinera-primary" %>
  </div>
<% end %>
