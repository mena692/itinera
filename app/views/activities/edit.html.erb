<div class="activity-edit-header">
  <div class="activity-edit-header__thumb">
    <% if @activity.image_url.present? %>
      <%= image_tag @activity.image_url, alt: @activity.name %>
    <% else %>
      <i class="fa-solid fa-mountain-sun"></i>
    <% end %>
  </div>

  <div class="activity-edit-header__info">
    <h3 class="activity-edit-header__name"><%= @activity.name %></h3>
    <p class="activity-edit-header__subtitle">Day <%= @day_number %> · <%= @activity.start_date.strftime("%A, %b %-d") %></p>
  </div>
</div>

<%= simple_form_for @activity do |f| %>
  <%= f.error_notification %>

  <div class="time-fields">
    <div class="time-field">
      <label class="form-label" for="activity_start_time">start</label>
      <div class="time-field__box">
        <i class="fa-regular fa-clock time-field__icon"></i>
        <%= time_field_tag "activity[start_time]", @activity.start_date&.strftime("%H:%M"),
              id: "activity_start_time", class: "time-field__input", required: true %>
      </div>
    </div>

    <div class="time-field">
      <label class="form-label" for="activity_end_time">end</label>
      <div class="time-field__box">
        <i class="fa-regular fa-clock time-field__icon"></i>
        <%= time_field_tag "activity[end_time]", @activity.end_date&.strftime("%H:%M"),
              id: "activity_end_time", class: "time-field__input", required: true %>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <span class="form-label">category</span>
    <div class="category-select">
      <% Activity::CATEGORIES.each do |cat| %>
        <label class="category-chip">
          <%= f.radio_button :category, cat, class: "category-chip__input" %>
          <span class="category-chip__label"><%= cat %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="mb-3">
    <div class="notes-field__header">
      <label class="form-label" for="activity_notes">notes</label>
      <span class="notes-field__optional">optional</span>
    </div>
    <%= f.text_area :notes, id: "activity_notes", class: "form-control notes-field__textarea", rows: 4 %>
  </div>

  <div class="form-actions">
    <%= link_to "cancel", @activity, class: "btn-itinera-secondary" %>
    <%= f.button :submit, "save changes", class: "btn-itinera-primary" %>
  </div>
<% end %>
