<h2>Let's get you started</h2>
<p>five fields and you’re ready to go!</p>

<%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= f.error_notification %>

<div class="form-inputs">
  <div class="d-flex names">
    <%= f.input :first_name,
                required: true,
                autofocus: true %>

    <%= f.input :last_name,
                required: true %>
  </div>

    <%= f.input :email,
                required: true,
                autofocus: true,
                input_html: { autocomplete: "email" }%>
  <div class="password-container">
    <%= f.input :password,
                required: true,
                hint: ("At least #{@minimum_password_length} characters, including 1 number" if @minimum_password_length),
                input_html: {
                  autocomplete: "new-password",
                  id: "user_password"
                } %>
  <span id="show-password">Show</span>
</div>
  <div class="form-actions">
    <%= f.button :submit, "Create an account" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>
