<% if message.role == "user" %>

  <div id="<%= dom_id(message) %>" class="message-row message-row-user">
    <div class="message-bubble message-bubble-user">
      <%= message.content %>
    </div>
  </div>

<% else %>

  <div id="<%= dom_id(message) %>" class="message-row message-row-assistant">

    <div class="message-sender">
      itinera
    </div>

    <% if message.content.start_with?("SUMMARY_READY") %>

      <% summary = message.content.sub("SUMMARY_READY", "").strip %>

      <div class="draft-ready-card">

        <p class="draft-ready-intro">
          I have enough context to plan your trip.
        </p>

        <div class="draft-ready-trip">
          <h3><%= message.chat.trip.destination %></h3>

          <p>
            <%= message.chat.trip.first_day.strftime("%b %-d") %>–<%= message.chat.trip.last_day.strftime("%-d") %>
            ·
            <%= message.chat.trip.trip_days.count %> days
          </p>
        </div>

        <div class="trip-recap">
          <% summary.each_line do |line| %>
            <% label, value = line.strip.split(":", 2) %>

            <% if label.present? && value.present? %>
              <div class="trip-recap-row">
                <span class="trip-recap-label">
                  <%= label %>
                </span>

                <span class="trip-recap-value">
                  <%= value.strip %>
                </span>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="draft-ready-status">
          DRAFT READY
        </div>

        <%= button_to "Generate full itinerary →",
                      trip_chat_messages_path(message.chat.trip, message.chat),
                      method: :post,
                      params: {
                        message: {
                          content: "generate full itinerary"
                        }
                      },
                      class: "generate-itinerary-button" %>

      </div>

    <% elsif message.content == "GENERATING_ITINERARY" %>

      <div class="message-bubble message-bubble-assistant message-content"
           data-controller="generating-message">
        <span data-generating-message-target="text"></span>
      </div>

    <% else %>

      <div class="message-bubble message-bubble-assistant message-content">
        <% if message.content.present? %>
          <%= message.content %>
        <% else %>
          ...
        <% end %>
      </div>

    <% end %>

  </div>

<% end %>
