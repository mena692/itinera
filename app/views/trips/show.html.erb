<% content_for :head do %>
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.28.1/mapbox-gl.css" rel="stylesheet">
<% end %>

<div class="trip-header">
  <div>
    <h1><%= @trip.name.presence || @trip.destination %></h1>
    <p>
      <%= @trip_days.first.date.strftime("%d %b") %> -
      <%= @trip_days.last.date.strftime("%d %b %Y") %>
      • <%= @trip_days.count %> days
  </p>
  </div>

  <%= render "trip_actions", trip: @trip %>
</div>

<div class="day-tabs" data-controller="day-tabs">
  <ul class="day-tabs__list">
    <% @trip_days.each_with_index do |t, index| %>
      <li class="day-tabs__item">
        <a href="?day=<%= index + 1 %>"
           class="day-tab <%= 'day-tab--active' if (params[:day] || '1').to_i == index + 1 %>">
          <span class="day-tab__title">Day <%= index + 1 %> · <%= t.name %></span>
          <span class="day-tab__subtitle"><%= t.description %></span>
        </a>
      </li>
    <% end %>
  </ul>
</div>


<div id="trip-map"
     data-controller="map"
     data-map-access-token-value="<%= ENV["MAPBOX_ACCESS_TOKEN"] %>"
     data-map-stops-value="<%= @activities.select { |a| a.latitude.present? && a.longitude.present? }
                                           .map { |a| { lat: a.latitude, lng: a.longitude, name: a.name, address: a.address } }
                                           .to_json %>">
</div>



<h2>daily activities</h2>
<p><%= @trip_day.date.strftime("%A, %b %d") %></p>
<p><%= @activities.count %> stops</p>
<hr width="100%" size="2">

<% @activities.each do |a| %>
  <div class="activity-row">
    <div class="activity-time"><%= a.start_date.strftime("%H:%M") %></div>

    <div class="activity-card"
         data-controller="activity-card"
         data-activity-card-url-value="<%= trip_trip_day_activity_path(@trip, @trip_day, a) %>"
         data-action="click->activity-card#visit click@window->activity-card#closeMenu">
      <%= image_tag a.image_url.presence || Activity::DEFAULT_IMAGE_URL,
                    class: "activity-card__thumb",
                    alt: a.name,
                    onerror: "this.onerror=null;this.src='#{image_path(Activity::DEFAULT_IMAGE_URL)}'" %>

      <div class="activity-card__content">
        <div class="activity-card__header">
          <h3 class="activity-card__title"><%= a.name %></h3>
          <button type="button" class="activity-card__menu" aria-label="More options" data-action="activity-card#toggleMenu">
            <span></span><span></span><span></span>
          </button>
        </div>

        <p class="activity-card__duration"><%= a.formatted_duration %></p>

        <span class="activity-card__chip"><%= a.category %></span>
      </div>

      <div class="activity-card__actions" data-activity-card-target="menu" hidden>
        <%= link_to edit_trip_trip_day_activity_path(@trip, @trip_day, a), class: "activity-card__action activity-card__action--edit" do %>
          <i class="fa-solid fa-pen activity-card__action-icon"></i>
          <span>edit</span>
        <% end %>
        <%= button_to trip_trip_day_activity_path(@trip, @trip_day, a), method: :delete,
              class: "activity-card__action activity-card__action--delete",
              form: { data: { turbo_confirm: "Delete #{a.name}?" } } do %>
          <i class="fa-solid fa-trash activity-card__action-icon"></i>
          <span>delete</span>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="trip-actions">
  <%= link_to new_trip_trip_day_activity_path(@trip, @trip_day, day: (params[:day] || 1)), class: "btn-itinera-secondary" do %>
    <span class="btn-icon">+</span> add activity
  <% end %>
  <%= button_to trip_chats_path(@trip), method: :post, class: "btn-itinera-primary" do %>
    ask itinera <span class="btn-icon">&#10022;</span>
  <% end %>
</div>
