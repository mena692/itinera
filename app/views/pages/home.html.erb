<div class="landing-page"
     data-controller="landing"
     data-action="touchstart->landing#touchStart touchend->landing#touchEnd">

  <!-- Splash screen -->
  <section class="splash-screen" data-landing-target="splash">
    <div class="splash-content">
      <%= image_tag "itinera-logo.svg", class: "splash-logo", alt: "Itinera" %>
      <p class="splash-tagline">travel redefined.</p>
    </div>
  </section>


  <!-- Landing slides -->
  <div class="landing-slides d-none" data-landing-target="content">

    <!-- Slide 1 -->
    <section class="landing-slide" data-landing-target="slide">

      <div class="landing-slide__media">
        <%= image_tag "photo1.jpg", class: "landing-slide__image", alt: "A quiet tiled street in Lisbon" %>
      </div>

      <div class="landing-header">
        <%= image_tag "itinera-logo.svg", class: "landing-logo", alt: "Itinera" %>
        <button type="button" class="landing-skip" data-action="landing#skip">skip</button>
      </div>

      <div class="landing-content">

        <p class="landing-step">1 / 3</p>

        <h1>
          say it in a sentence,<br>
          get a whole trip
        </h1>

        <p class="landing-description">
          “four days in lisbon, mostly food and walking” is a complete brief.
          itinera turns it into timed days you can actually follow.
        </p>

        <div class="landing-progress">
          <button class="progress-item active"
                  data-action="click->landing#goToSlide"
                  data-slide="0">
          </button>

          <button class="progress-item"
                  data-action="click->landing#goToSlide"
                  data-slide="1">
          </button>

          <button class="progress-item"
                  data-action="click->landing#goToSlide"
                  data-slide="2">
          </button>
        </div>
          <div class="landing-actions">
            <%= link_to "create an account →",
                        new_user_registration_path,
                        class: "btn-itinera-primary landing-button" %>
            <%= link_to "log in",
                        new_user_session_path,
                        class: "btn-itinera-secondary landing-button" %>
          </div>
      </div>
    </section>


    <!-- Slide 2 -->
    <section class="landing-slide d-none" data-landing-target="slide">

      <div class="landing-slide__media">
        <%= image_tag "photo2.jpeg", class: "landing-slide__image", alt: "Traveler checking departures at a train station" %>
      </div>

      <div class="landing-header">
        <%= image_tag "itinera-logo.svg", class: "landing-logo", alt: "Itinera" %>
        <button type="button" class="landing-skip" data-action="landing#skip">skip</button>
      </div>

      <div class="landing-content">

        <p class="landing-step">2 / 3</p>

        <h1>
          every day<br>
          walks properly
        </h1>

        <p class="landing-description">
          stops are ordered by travel time, not by list order.
          you see the walk, the train and the gap before you commit to a day.
        </p>

        <div class="landing-progress">
          <button class="progress-item"
                  data-action="click->landing#goToSlide"
                  data-slide="0">
          </button>

          <button class="progress-item active"
                  data-action="click->landing#goToSlide"
                  data-slide="1">
          </button>

          <button class="progress-item"
                  data-action="click->landing#goToSlide"
                  data-slide="2">
          </button>
        </div>

        <div class="landing-actions">
          <%= link_to "create an account →",
                      new_user_registration_path,
                      class: "btn-itinera-primary landing-button" %>
          <%= link_to "log in",
                      new_user_session_path,
                      class: "btn-itinera-secondary landing-button" %>
        </div>

      </div>
    </section>


    <!-- Slide 3 -->
    <section class="landing-slide d-none" data-landing-target="slide">

      <div class="landing-slide__media">
        <%= image_tag "photo3.jpg", class: "landing-slide__image", alt: "Waking up to a sunrise view over the Bosphorus in Istanbul" %>
      </div>

      <div class="landing-header">
        <%= image_tag "itinera-logo.svg", class: "landing-logo", alt: "Itinera" %>
        <button type="button" class="landing-skip" data-action="landing#skip">skip</button>
      </div>

      <div class="landing-content">

        <p class="landing-step">3 / 3</p>

        <h1>
          change your mind<br>
          mid-trip
        </h1>

        <p class="landing-description">
          ask for a lighter morning or a cheaper dinner and the day reflows around it.
          your edits always win over the draft.
        </p>

        <div class="landing-progress">
          <button class="progress-item"
                  data-action="click->landing#goToSlide"
                  data-slide="0">
          </button>

          <button class="progress-item"
                  data-action="click->landing#goToSlide"
                  data-slide="1">
          </button>

          <button class="progress-item active"
                  data-action="click->landing#goToSlide"
                  data-slide="2">
          </button>
        </div>

        <div class="landing-actions">
          <%= link_to "create an account →",
                      new_user_registration_path,
                      class: "btn-itinera-primary landing-button" %>
          <%= link_to "log in",
                      new_user_session_path,
                      class: "btn-itinera-secondary landing-button" %>
        </div>

      </div>
    </section>

  </div>
</div>
