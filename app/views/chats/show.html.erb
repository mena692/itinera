<div class="app-screen">

  <main class="home-page">

    <!-- Header -->
    <header class="home-header">
      <div class="brand">
        <i class="fa-solid fa-location-dot"></i>
        <span>itinera</span>
      </div>

      <%= link_to "#", class: "profile-button" do %>
        <i class="fa-regular fa-user"></i>
      <% end %>
    </header>


    <!-- Main content -->
    <section class="home-content">

      <h1>your trips</h1>

      <p class="home-subtitle">
        ready for your next adventure?
      </p>


      <!-- Empty state -->
      <div class="empty-trips-card">

        <h2>nothing on the calendar</h2>

        <p>
          tell itinera where you're going — it drafts the days,<br>
          you edit them.
        </p>

        <%= link_to new_trip_path, class: "new-trip-button" do %>
          <i class="fa-solid fa-plus"></i>
          <span>create a new trip</span>
        <% end %>

      </div>

    </section>

  </main>


  <!-- Bottom navigation -->
  <nav class="bottom-nav">

    <%= link_to root_path, class: "nav-item active" do %>
      <i class="fa-solid fa-house"></i>
      <span>home</span>
    <% end %>


    <%= link_to trips_path, class: "nav-item" do %>
      <i class="fa-regular fa-folder"></i>
      <span>my trips</span>
    <% end %>


    <%= link_to new_trip_path, class: "nav-item" do %>
      <div class="new-trip-icon">
        <i class="fa-solid fa-plus"></i>
      </div>
      <span>new trip</span>
    <% end %>


    <%= link_to "#", class: "nav-item" do %>
      <i class="fa-regular fa-user"></i>
      <span>profile</span>
    <% end %>

  </nav>

</div>
